# .gitignore for CargoAI Matching
# Node modules
node_modules/

# Build output
dist/
build/

# Logs
*.log
logs/

# Environment variables
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# SQLite database
*.sqlite

# Coverage
coverage/

# Misc
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Old services logs
oldservices/**/logs/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
