  "scripts": {
    "build": "node api.js && nest build --webpack",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node api.js && nest start",
    "start:dev": "nest start --watch --webpack",
    "start:dev:node": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "npm run migration:check && node dist/main",
    "start:prod:safe": "npm run deploy:migrate && node dist/main",
    "migration:check": "node scripts/check-migrations.js",
    "deploy:migrate": "bash scripts/backup-and-migrate.sh",
    "migrate": "npm run build && node run-migrations.js",
    "websocket:server": "node websocket-server.js",
    "postbuild": "echo Build completed successfully",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/database-postgres.config.ts src/migrations/AutoMigration",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "migration:run:progress": "ts-node run-migrations-progress.ts",
    "migration:generate:linux": "npx typeorm-ts-node-commonjs migration:generate -d src/config/database-postgres.config.ts src/migrations/AutoMigration",
    "migration:run:linux": "npx typeorm-ts-node-commonjs migration:run -d src/config/database-postgres.config.ts",
    "migrations:run": "node run-all-migrations.js",
    "migrations:status": "node run-all-migrations.js --status",
    "migrations:force": "node run-all-migrations.js --force",
    "migrations:rollback": "node run-all-migrations.js --rollback",
    "migrations:create": "node create-migration.js",
    "migrations:export": "node export-current-schema.js",
    "deploy:check": "bash scripts/pre-deploy-check.sh",
    "deploy:safe": "bash scripts/safe-deploy.sh",
    "deploy:prod": "npm run deploy:check && npm run deploy:migrate && pm2 restart ecosystem.config.js",
    "create:cargo-inspections-table": "ts-node src/scripts/create-cargo-inspections-table.ts",
    "create:truck-owner": "ts-node src/scripts/create-truck-owner.ts",
    "verify:truck-owner": "ts-node src/scripts/verify-truck-owner.ts",
    "fix:login": "ts-node src/scripts/fix-login-issue.ts",
    "fix:truck-owner": "node src/database/seeds/fix-truck-owner-user.js",
    "seed:all": "node src/database/seeds/seed-all-data.js",
    "seed:complete": "node src/database/seeds/seed-complete-system.js",
    "seed:companies": "node src/database/seeds/seed-companies.js",
    "seed:brokers": "node src/database/seeds/seed-brokers.js",
    "seed:cargos-brokers": "node src/database/seeds/seed-cargos-with-brokers.js",
    "check:broker-data": "node src/database/seeds/check-broker-data.js",
    "fix:broker-profiles": "node src/database/seeds/fix-broker-profiles.js",
    "verify:cargo-owner": "node src/database/seeds/verify-cargo-owner.js",
    "seed:admin": "node src/database/seeds/seed-admin.js",
    "seed:admin-user": "node src/database/seeds/seed-admin-user.js",
    "seed:super-admin": "node seed-super-admin.js",
    "seed:payments": "node src/database/seeds/seed-payment-workflow.js",
    "create:admin": "ts-node src/scripts/create-admin-user.ts",
    "user:set-password": "ts-node src/scripts/set-user-password.ts",
    "user:reset-password": "node src/database/scripts/reset-password-by-id.js",
    "users:list": "ts-node src/scripts/list-users.ts",
    "diagnose:login": "ts-node src/scripts/diagnose-login-issue.ts",
    "seed:users": "ts-node src/scripts/seed-users.ts",
    "seed:matching": "ts-node -r tsconfig-paths/register src/scripts/seed-matching-data.ts",
    "seed:matching-demo": "ts-node -r tsconfig-paths/register src/scripts/seed-matching-demo.ts",
    "seed:matching-algorithms": "ts-node -r tsconfig-paths/register src/scripts/seed-matching-algorithms-test.ts"
  },
